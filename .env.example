APP_NAME=Kayaa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Colombo
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kayaa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@kayaa.lk"
MAIL_FROM_NAME="${APP_NAME}"

# First admin user, created by the seeder
ADMIN_NAME="Kayaa Admin"
ADMIN_EMAIL=admin@kayaa.lk
ADMIN_PASSWORD=change-me-now

# Store settings (rupees)
STORE_SHIPPING_FEE=450
STORE_FREE_SHIPPING_OVER=7500
# Fallbacks only — Admin > Contact details overrides these once set.
STORE_WHATSAPP="077 000 0000"
STORE_PHONE="077 000 0000"

# Lets the deploy workflow run migrations over HTTPS (this host has no SSH).
# Generate a long random value; leave empty to disable the route entirely.
DEPLOY_TOKEN=

# PayHere (added later)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Staging only: keep the site out of search engines
APP_NOINDEX=false
